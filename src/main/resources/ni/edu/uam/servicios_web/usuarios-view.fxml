<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="450.0" prefWidth="820.0" spacing="12.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.servicios_web.controller.UsuarioController">
    <padding>
        <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
    </padding>
    <children>
        <Label text="Consulta de usuarios">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <Button fx:id="btnConsultar" mnemonicParsing="false" onAction="#consultar" text="Consultar usuarios" />
                <Label fx:id="lblEstado" text="Haga click en el boton &quot;Consultar usuarios&quot;" />
            </children>
        </HBox>

        <TableView fx:id="tblUsuarios" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="91.33334541320801" text="ID" />
                <TableColumn fx:id="colNombre" prefWidth="103.99996185302734" text="Nombre" />
                <TableColumn fx:id="colUsername" prefWidth="100.0" text="Username" />
                <TableColumn fx:id="colEmail" prefWidth="170.0" text="Correo" />
                <TableColumn fx:id="colTelefono" prefWidth="130.0" text="Teléfono" />
                <TableColumn fx:id="colCiudad" prefWidth="100.0" text="Ciudad" />
                <TableColumn fx:id="colEmpresa" prefWidth="120.0" text="Empresa" />
            </columns>
        </TableView>
    </children>
</VBox>
