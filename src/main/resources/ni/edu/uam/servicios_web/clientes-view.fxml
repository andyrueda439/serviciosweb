<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="480.0" prefWidth="1150.0" spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.servicios_web.controller.ClienteController">
    <padding>
        <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
    </padding>
    <children>
        <Label text="Consulta de clientes">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <Button fx:id="btnConsultar" mnemonicParsing="false" onAction="#consultar" text="Consultar clientes" />
                <Label fx:id="lblEstado" text="Haga click en el boton &quot;Consultar clientes&quot;" />
            </children>
        </HBox>

        <TableView fx:id="tblClientes" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="45.0" text="ID" />

                <TableColumn fx:id="colNombre" prefWidth="90.0" text="Nombre" />
                <TableColumn fx:id="colApellido" prefWidth="90.0" text="Apellido" />
                <TableColumn fx:id="colEmail" prefWidth="170.0" text="Correo" />
                <TableColumn fx:id="colTelefono" prefWidth="110.0" text="Teléfono" />
                <TableColumn fx:id="colFechaNacimiento" prefWidth="100.0" text="Nacimiento" />
                <TableColumn fx:id="colPais" prefWidth="80.0" text="País" />
                <TableColumn fx:id="colCiudad" prefWidth="90.0" text="Ciudad" />
                <TableColumn fx:id="colDireccion" prefWidth="140.0" text="Dirección" />
                <TableColumn fx:id="colIngreso" prefWidth="110.0" text="Ingreso anual" />
                <TableColumn fx:id="colPuntaje" prefWidth="90.0" text="Puntaje" />
            </columns>
        </TableView>
    </children>
</VBox>